  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary production or playback action.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Start</button>",
      "css": ".ds-button-primary { min-height: 36px; padding: 6px 13px; border: 1px solid var(--green); border-radius: 12px; background: var(--green); color: #fffefb; font: 600 14px/20px \"Source Sans 3\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", sans-serif; transition: background-color .16s ease-out, border-color .16s ease-out; } .ds-button-primary:hover:not(:disabled) { border-color: var(--green-hover); background: var(--green-hover); } .ds-button-primary:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }"
    },
    {
      "name": "Warm Action",
      "kind": "button",
      "refersTo": "button-warm",
      "description": "Secondary confirmation or adoption action.",
      "html": "<button class=\"ds-button-warm\" type=\"button\">Adopt</button>",
      "css": ".ds-button-warm { min-height: 36px; padding: 6px 13px; border: 1px solid var(--gold); border-radius: 12px; background: var(--gold); color: #3d3422; font: 600 14px/20px \"Source Sans 3\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", sans-serif; } .ds-button-warm:hover:not(:disabled) { border-color: #d9bb68; background: #edd58d; } .ds-button-warm:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Compact text or instruction entry.",
      "html": "<label class=\"ds-field\"><span>Instruction</span><textarea rows=\"3\"></textarea></label>",
      "css": ".ds-field { display: grid; gap: 5px; color: var(--muted); font: 400 12px/18px \"Source Sans 3\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", sans-serif; } .ds-field textarea { min-height: 84px; padding: 7px 10px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface-raised); color: var(--ink); font: 400 14px/1.55 \"Source Sans 3\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", sans-serif; } .ds-field textarea:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }"
    },
    {
      "name": "Themed Select",
      "kind": "input",
      "refersTo": "select",
      "description": "Book, speaker, and playback speed selection with themed open and selected states.",
      "html": "<select class=\"ds-select\" aria-label=\"Choose an item\"><option selected>Current item</option><option>Another item</option></select>",
      "css": ".ds-select, .ds-select::picker(select) { appearance: base-select; } .ds-select { min-height: 40px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface-raised); color: var(--ink); font: 400 14px/1.55 \"Source Sans 3\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", sans-serif; } .ds-select:hover, .ds-select:open { border-color: var(--green); background: var(--green-soft); } .ds-select::picker(select) { overflow: auto; padding: 4px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface-raised); color: var(--ink); box-shadow: var(--shadow-menu); } .ds-select option { min-height: 40px; padding: 8px 10px; border-radius: 12px; color: var(--ink); background: var(--surface-raised); } .ds-select option:checked, .ds-select option:hover, .ds-select option:focus { background: var(--green-soft); color: var(--ink); } .ds-select option::checkmark { color: var(--green); } .ds-select:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }"
    },
    {
      "name": "Primary Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Three top-level work destinations with a clear current-page underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Primary\"><a href=\"#\" class=\"ds-nav-item\">Chapters</a><a href=\"#\" class=\"ds-nav-item is-active\" aria-current=\"page\">Review</a><a href=\"#\" class=\"ds-nav-item\">Voices</a></nav>",
      "css": ".ds-nav { display: flex; min-height: 46px; align-items: stretch; gap: 22px; } .ds-nav-item { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; padding: 8px 2px; border-bottom: 2px solid transparent; color: var(--muted); font: 600 14px/1.55 \"Source Sans 3\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", sans-serif; text-decoration: none; } .ds-nav-item:hover { color: var(--ink); } .ds-nav-item.is-active { border-bottom-color: var(--green); color: var(--green-text); } .ds-nav-item:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }"
    },
    {
      "name": "Surface",
      "kind": "card",
      "refersTo": "surface",
      "description": "Flat bordered work area for lists, transcripts, and forms.",
      "html": "<section class=\"ds-surface\"><h2>Work area</h2><p>Content</p></section>",
      "css": ".ds-surface { min-width: 0; padding: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--ink); } .ds-surface h2 { margin: 0 0 12px; font: 600 16px/1.5 \"Source Sans 3\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", sans-serif; }"
    }
  ],
  "narrative": {
    "northStar": "Local Audiobook Workbench",
    "overview": "The interface supports chapter production, listening review, and character voice management. The topbar provides access to these three work areas and keeps book, theme, cost, and exit controls nearby. The chapter, transcript, and voice surfaces prioritize readable content and direct actions.\n\nThe light theme uses warm paper and near-white surfaces. The dark theme uses charcoal surfaces with the same green, gold, rust, and status roles. The 12px corner radius, compact type scale, and fixed playback dock support repeated work with chapters, transcripts, and forms.",
    "keyCharacteristics": [
      "Chapter production, listening review, and character voice management each have a topbar destination.",
      "Green identifies actions and active selections. Gold identifies secondary actions and pending review. Rust identifies caution and correction.",
      "Light and dark themes use the same semantic color roles.",
      "The interface uses compact lists, transcript text, forms, and persistent playback controls."
    ],
    "rules": [],
    "dos": [
      "Do keep chapters, listening review, and character voices together in the topbar navigation.",
      "Do use warm paper in light mode and warm charcoal in dark mode with the same green, gold, and rust roles.",
      "Do style speaker and playback speed selects with 14px text, 40px height, and a 12px radius.",
      "Do theme the closed select, open picker, option hover, and selected option.",
      "Do preserve Enter, Escape, and arrow-key operation for native selects.",
      "Do use 24px and 32px for primary work-area separation and 8px to 16px inside compact control groups.",
      "Do show candidate states through color and text labels."
    ],
    "donts": [
      "Don't introduce blue or purple into the interface palette.",
      "Don't assign different semantic colors to the same action or state in light and dark modes.",
      "Don't use color alone to identify selected, pending, error, or playback states.",
      "Don't leave the select picker or its options in an unrelated browser theme.",
      "Don't use large card shadows as the default depth treatment."
    ]
  }
}
